{
  "name": "alroyndhlovu-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prune-assets.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run qa && node scripts/deploy.mjs",
    "resume": "npm run build && node scripts/build-resume-pdf.mjs && npm run resume:verify",
    "resume:verify": "node scripts/verify-resume-pdf.mjs",
    "resume:preview": "node scripts/ats-preview.mjs",
    "resume:render": "node scripts/preview-pdf.mjs",
    "qa": "npm run check && npm run lint && npm run lint:tokens && npm run format:check && npm run build && npm run check:links && npm run check:redirects && npm run resume:verify && npm run qa:browser",
    "qa:browser": "node scripts/qa-browser.mjs",
    "lottie": "node scripts/theme-lottie.mjs",
    "video": "node scripts/optimize-video.mjs",
    "media:import": "node scripts/import-work-media.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.68.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "ffmpeg-static": "^5.3.0",
    "lottie-web": "^5.13.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
