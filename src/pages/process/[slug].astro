---
/**
 * Process write-ups: /process/<slug>/.
 *
 * Same renderer as the client case studies and product build stories.
 * These answer a third question — how was this made, and with what —
 * so they get their own path and are reached from the portfolio
 * section rather than from section 05 or 06.
 */
import CaseStudyArticle from "../../components/CaseStudyArticle.astro";
import { PROCESS_STUDIES, type CaseStudy } from "../../data/case-studies";

export function getStaticPaths() {
  return PROCESS_STUDIES.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

<CaseStudyArticle study={study} />
