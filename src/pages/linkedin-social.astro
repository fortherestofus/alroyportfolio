---
/**
 * The feed image for a boosted post. Rendered to PNG by
 * scripts/build-social-image.mjs, and never printed to the PDF.
 *
 * It is a separate route on purpose. The document ad's cover and a
 * feed image have different jobs, and one artefact cannot do both:
 *
 *   The cover is read by someone who has already stopped scrolling and
 *   opened the document. It can afford a 63-character headline, a
 *   two-line standfirst and a contact line, because the reader has
 *   committed and is looking for orientation.
 *
 *   This is read at about 350px wide, by a thumb that has not decided
 *   anything yet. At that width the cover's 46pt headline renders
 *   around 8px, which is not small type, it is no type. So this card
 *   carries one idea, in six words, at roughly three times the size.
 *
 * Keeping it apart means the ad never inherits a compromise made for
 * the feed, and the feed image never inherits one made for the ad.
 *
 * The claim is the Harvard Business Review finding the document already
 * cites on slide 02. It leads here rather than sits in the body because
 * it is the only line in the whole set that is about the reader rather
 * than about Alroy, and a stranger stops for themselves.
 */
import { Image } from "astro:assets";
import SlidesLayout from "../layouts/SlidesLayout.astro";
import portrait from "../assets/images/alroy-portrait-ink.jpg";

/* Matches the cover's source width. The card prints at 2x, so this is
   the same density the PDF carries. */
const W_PORTRAIT = 700;
---

<SlidesLayout
  title="Alroy Ndhlovu — feed image"
  description="Single-image creative for a boosted LinkedIn post."
>
  <section class="slide slide--ink social">
    <div class="social__text">
      <h1 class="social__headline">Most businesses solve the wrong problem.</h1>
      <p class="social__stat">
        85% of executives say their organisation is bad at diagnosing problems. 87% say it is
        costing them money.
      </p>
      <p class="social__source">Harvard Business Review, 106 executives, 17 countries</p>
      <div class="social__foot">
        <span class="social__name">Alroy Ndhlovu</span>
        <span class="social__role">Marketing · Brand · Design · Product</span>
        <span class="social__site">alroyndhlovu.com</span>
      </div>
    </div>
    <div class="social__portrait">
      <Image
        src={portrait}
        alt="Alroy Ndhlovu"
        width={W_PORTRAIT}
        densities={[1]}
        loading="eager"
      />
    </div>
  </section>
</SlidesLayout>
