---
/**
 * The two 4:5 cards for a boosted multi-image post. PNG only, rendered
 * by scripts/build-social-image.mjs. Never printed to the PDF.
 *
 * Why 4:5 and why two.
 *
 * LinkedIn renders multi-image tiles at up to 4:5 and centre-crops
 * anything wider, so the document's 16:9 sheets cannot be reused here:
 * cropped to 4:5 each loses more than half its width. 4:5 is also the
 * tallest ratio the feed will render, so it takes the most vertical
 * space available.
 *
 * Two, because the first two tiles show side by side and everything
 * after them sits behind a swipe that a cold audience does not take.
 * With exactly two, the whole paid impression is on screen at once.
 *
 * Each tile lands around 175px wide on a phone, so the budget is about
 * six words at headline size per card. Card one is the hook and nothing
 * else. Card two is who is saying it.
 *
 * Light and dark on purpose: side by side the pair reads as one object
 * rather than two unrelated posts.
 */
import { Image } from "astro:assets";
import SlidesLayout from "../layouts/SlidesLayout.astro";
import portrait from "../assets/images/alroy-portrait-ink.jpg";

const W_PORTRAIT = 900;
---

<SlidesLayout
  title="Alroy Ndhlovu — feed cards"
  description="Two 4:5 cards for a boosted LinkedIn multi-image post."
>
  {/* ---------------------------------------------- 1 · THE HOOK */}
  <section class="card card--ink">
    <div class="card__portrait">
      <Image
        src={portrait}
        alt="Alroy Ndhlovu"
        width={W_PORTRAIT}
        densities={[1]}
        loading="eager"
      />
    </div>
    <div class="card__over">
      <h1 class="card__hook">Most businesses solve the wrong problem.</h1>
      <p class="card__source">
        85% of executives agree. Harvard Business Review, 106 executives, 17 countries.
      </p>
    </div>
  </section>

  {/* ------------------------------------------ 2 · WHO IS SAYING IT */}
  <section class="card card--light">
    <p class="card__name">Alroy Ndhlovu</p>
    <h2 class="card__claim">I identify business problems, then build solutions around them.</h2>
    <div class="card__facts">
      <p class="card__disciplines">Marketing · Brand · Design · Product</p>
      <p class="card__proof">
        12+ years · 1,200+ projects · Work for the IFC, Meta and Digify Africa
      </p>
    </div>
    <p class="card__site">alroyndhlovu.com</p>
  </section>
</SlidesLayout>
