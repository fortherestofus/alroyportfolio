---
/**
 * The LinkedIn document ad, printed to
 * public/alroy-ndhlovu-linkedin.pdf by `npm run resume`.
 *
 * Twelve 960 x 540pt sheets, 16:9, which is what LinkedIn's document
 * format takes. The slides themselves live in LinkedInSlides.astro and
 * are shared with the portrait route; this page is the landscape
 * wrapper and the one the PDF pipeline prints.
 */
import SlidesLayout from "../layouts/SlidesLayout.astro";
import LinkedInSlides from "../components/LinkedInSlides.astro";

const DESCRIPTION =
  "Alroy Ndhlovu — marketing, brand, product and AI-native build. Twelve years, 1,200+ projects, four products shipped in 2026.";
---

<SlidesLayout title="Alroy Ndhlovu — Introduction" description={DESCRIPTION}>
  <LinkedInSlides />
</SlidesLayout>
