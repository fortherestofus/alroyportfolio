---
/**
 * Client case studies: /case-studies/<slug>/.
 *
 * Only `kind: "client"` studies route here. The build stories for
 * Alroy's own products use the same renderer at /products/<slug>/,
 * because a product and the work done for a client are answering two
 * different questions — can he build, and what did it return — and a
 * reader should be able to tell which one they are in from the URL.
 */
import CaseStudyArticle from "../../components/CaseStudyArticle.astro";
import { CLIENT_STUDIES, type CaseStudy } from "../../data/case-studies";

export function getStaticPaths() {
  return CLIENT_STUDIES.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

<CaseStudyArticle study={study} />
