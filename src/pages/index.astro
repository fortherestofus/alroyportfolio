---
/**
 * The journey page.
 *
 * Phase 2 puts the shell in place: the timeline nav and the six
 * two-column sections. Their right columns are intentionally empty and
 * carry a note naming the phase that fills them.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import JourneyNav from "../components/JourneyNav.astro";
import JourneySection from "../components/JourneySection.astro";
import { SITE, SECTIONS } from "../data/site";

/** Temporary: what lands in each right column, and when. */
const PENDING: Record<string, string> = {
  who: "Phase 3 — profile photo, bio, service pills, proof row",
  experience: "Phase 3 — 11 roles with company icons",
  education: "Phase 3 — 4 themed groups",
  portfolio: "Phase 4 — 5 category cards and the modal carousel",
  "case-studies": "Phase 5 — stacked overview cards",
  contact: "Phase 6 — email, phone, Cal.com embed, socials",
};
---

<BaseLayout title={SITE.title} description={SITE.description} path="/">
  <JourneyNav slot="nav" />

  <header class="hero">
    <div class="hero__inner" data-reveal>
      <p class="eyebrow" data-reveal-item>Full-stack marketing, branding and business tech</p>
      <h1 data-reveal-item>Alroy Ndhlovu</h1>
      <p class="hero__blurb" data-reveal-item>
        I help businesses grow by designing high-impact solutions through data-driven marketing,
        analytics, automation, AI and creative strategy.
      </p>
    </div>
  </header>

  {
    SECTIONS.map((section) => (
      <JourneySection
        id={section.id}
        number={section.number}
        label={section.label}
        heading={section.heading}
        blurb={section.blurb}
      >
        <div class="pending" data-reveal>
          <p class="eyebrow">Coming next</p>
          <p class="pending__note">{PENDING[section.id]}</p>
        </div>
      </JourneySection>
    ))
  }
</BaseLayout>

<script>
  import "../scripts/journey";
</script>

<style>
  .hero {
    padding-top: calc(var(--nav-height-mobile) + var(--space-8));
    padding-bottom: var(--space-8);
  }

  .hero__inner {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  h1 {
    margin-top: var(--space-3);
  }

  .hero__blurb {
    margin-top: var(--space-5);
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  /*
   * Scaffolding for Phase 2 only. The min-height gives each right
   * column enough length to prove the left column pins and releases
   * correctly; it comes out as real content lands.
   */
  .pending {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 70vh;
    padding: var(--space-6);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }

  .pending__note {
    color: var(--color-text-faint);
  }

  @media (width >= 1024px) {
    .hero {
      padding-top: calc(var(--nav-height) + var(--space-9));
      padding-bottom: var(--space-9);
    }

    .pending {
      min-height: 120vh;
    }
  }
</style>
