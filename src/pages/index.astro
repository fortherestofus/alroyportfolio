---
/**
 * The journey page.
 *
 * Phase 2 puts the shell in place: the timeline nav and the six
 * two-column sections. Their right columns are intentionally empty and
 * carry a note naming the phase that fills them.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import JourneyNav from "../components/JourneyNav.astro";
import JourneySection from "../components/JourneySection.astro";
import WhoIsAlroy from "../components/WhoIsAlroy.astro";
import ExperienceList from "../components/ExperienceList.astro";
import EducationGroups from "../components/EducationGroups.astro";
import PortfolioGrid from "../components/PortfolioGrid.astro";
import ProductShowcase from "../components/ProductShowcase.astro";
import CaseStudyStack from "../components/CaseStudyStack.astro";
import ContactSection from "../components/ContactSection.astro";
import CalEmbed from "../components/CalEmbed.astro";
import HeroCollage from "../components/HeroCollage.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { ArrowDown } from "@lucide/astro";
import { SITE, SECTIONS, SOCIAL } from "../data/site";
import { CASE_STUDIES } from "../data/case-studies";
import { SERVICES } from "../data/services";

/*
 * Structured data for the home page (PRD §9, GEO/AIO).
 *
 * A ProfilePage wrapping a Person, because that is what this is —
 * schema.org added ProfilePage precisely for "a page about one person"
 * and it is what lets an engine attribute the whole site to Alroy
 * rather than to an unnamed organisation. `sameAs` is the property
 * that links this identity to his profiles elsewhere, which is how
 * knowledge panels get built.
 *
 * The WebSite entry exists so the site itself is a named thing an AI
 * answer can cite, and the ItemList surfaces the case studies as
 * distinct works rather than leaving them buried in the page body.
 */
const person = {
  "@type": "Person",
  "@id": `${SITE.url}/#alroy`,
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  telephone: SITE.phone,
  jobTitle: "Marketing, Branding, Business Technology and Product Consultant",
  description: SITE.bio,
  knowsAbout: SERVICES.map((service) => service.name),
  address: { "@type": "PostalAddress", addressCountry: "ZA" },
  sameAs: [SOCIAL.linkedin, SOCIAL.dribbble, SOCIAL.instagram, SOCIAL.github],
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": `${SITE.url}/#profilepage`,
    url: SITE.url,
    name: SITE.title,
    description: SITE.description,
    inLanguage: SITE.locale.replace("_", "-"),
    mainEntity: person,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.description,
    inLanguage: SITE.locale.replace("_", "-"),
    publisher: { "@id": `${SITE.url}/#alroy` },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Case studies",
    itemListElement: CASE_STUDIES.map((study, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${SITE.url}/case-studies/${study.slug}/`,
      name: `${study.name} case study`,
    })),
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description} path="/" schema={schema}>
  <JourneyNav slot="nav" />

  <header class="hero" id="top">
    <HeroCollage />

    <div class="hero__inner" data-reveal>
      <p class="eyebrow" data-reveal-item>
        Full-stack marketing, branding, business tech and product
      </p>
      <h1 data-reveal-item>Alroy Ndhlovu</h1>
      <p class="hero__blurb" data-reveal-item>
        I help businesses grow by designing high-impact solutions through data-driven marketing,
        analytics, automation, AI and creative strategy.
      </p>

      {
        /*
         * Anchors, not buttons. Following a fragment is navigation: it
         * works with no JS, gets the link role so it appears in a screen
         * reader's links list, updates the URL so the position is
         * shareable, and behaves under ⌘-click. A <button> with a scroll
         * handler throws all of that away and announces the wrong role.
         *
         * Labels name their destination rather than saying "Get started".
         * NN/g's testing of generic labels found people clicking them
         * expecting information, hitting a commitment instead, and
         * leaving — and "Book a 15 min chat" has to keep its promise,
         * which it does: section 07 embeds exactly that calendar.
         */
      }
      <div class="hero__actions" data-reveal-item>
        <a class="hero__cta hero__cta--primary" href="#portfolio">
          See the work
          <ArrowDown class="hero__cta-icon" aria-hidden="true" />
        </a>
        <a class="hero__cta hero__cta--secondary" href="#contact"> Book a 15 min chat </a>
      </div>
    </div>
  </header>

  {
    SECTIONS.map((section) => (
      <JourneySection
        id={section.id}
        number={section.number}
        label={section.label}
        heading={section.heading}
        blurb={section.blurb}
        lottie={"lottie" in section ? section.lottie : undefined}
      >
        {section.id === "who" && <WhoIsAlroy />}
        {section.id === "experience" && <ExperienceList />}
        {section.id === "education" && <EducationGroups />}
        {section.id === "portfolio" && <PortfolioGrid />}
        {section.id === "products" && <ProductShowcase />}
        {section.id === "case-studies" && <CaseStudyStack />}
        {section.id === "contact" && <ContactSection />}
        {section.id === "contact" && <CalEmbed slot="wide" />}
      </JourneySection>
    ))
  }

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import "../scripts/journey";
  import "../scripts/portfolio";
</script>

<style>
  /*
   * Tall, but deliberately not a full viewport.
   *
   * `svh`, not `vh`: the unprefixed unit is defined against the *large*
   * viewport, so on a phone with the toolbar showing — which is its
   * state on first paint — 100vh is taller than what you can see and
   * the bottom of the hero sits behind the browser chrome. `svh` sizes
   * against the toolbar being out, and unlike `dvh` it does not resize
   * mid-scroll.
   *
   * `min-height`, not `height`, so the box grows rather than overflows
   * when text is resized to 200% or the blurb wraps to five lines.
   *
   * And short of the full viewport on purpose. NN/g's "illusion of
   * completeness" work found readers who did not realise a page
   * scrolled at all when a full-screen hero ended exactly at the fold —
   * a sparse dark hero with a clean bottom edge is the textbook case.
   * Holding back one space step leaves the next section visibly
   * intruding, which is their prescribed fix and reads better than an
   * arrow telling people to scroll.
   *
   * The nav gap is not subtracted again: box-sizing is border-box
   * globally and the padding below already carries it.
   */
  .hero {
    position: relative;
    /* The collage is absolutely positioned to this box. */
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - var(--space-8));
    padding-top: calc(var(--nav-height-mobile) + var(--space-8));
    padding-bottom: var(--space-8);
  }

  .hero__inner {
    /* Above the collage, which is absolutely positioned behind it. */
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  h1 {
    margin-top: var(--space-3);
  }

  /* --- Hero calls to action ---------------------------------- */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-lg);
    padding-inline: var(--space-5);
    border-radius: var(--radius-pill);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-heading);
    border: 1px solid transparent;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  /*
   * The one solid block of accent on the page, which is most of what
   * gives the hero its colour. Dark text on it rather than white: the
   * green is light enough that white would sit at about 1.6:1.
   */
  .hero__cta--primary {
    background-color: var(--color-accent);
    color: var(--color-invert-text);
  }

  .hero__cta--primary:hover,
  .hero__cta--primary:focus-visible {
    background-color: var(--color-accent-olive);
  }

  /*
   * Filled, not a ghost. NN/g's eye-tracking study (n=71) measured
   * weak clickability signifiers costing 22% more time and 25% more
   * fixations, both significant — an outline alone on a busy hero is
   * exactly that. A real surface plus a boundary that clears 3:1 makes
   * it read as a control while still ranking below the primary.
   */
  .hero__cta--secondary {
    background-color: var(--color-surface);
    border-color: var(--color-border-control);
    color: var(--color-text);
  }

  .hero__cta--secondary:hover,
  .hero__cta--secondary:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero__cta-icon {
    width: var(--icon-md);
    height: var(--icon-md);
    stroke-width: 2;
  }

  .hero__blurb {
    margin-top: var(--space-5);
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  @media (width >= 1024px) {
    .hero {
      min-height: calc(100svh - var(--space-9));
      padding-top: calc(var(--nav-height) + var(--space-9));
      padding-bottom: var(--space-9);
    }
  }
</style>
