---
/**
 * The journey page. Phase 1 establishes the six section landmarks
 * so anchors and the 404 nav resolve; Phase 2 adds the timeline nav
 * and two-column structure, Phases 3-6 fill the content.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, SECTIONS } from "../data/site";
---

<BaseLayout title={SITE.title} description={SITE.description} path="/">
  <div class="journey">
    <header class="journey__intro">
      <p class="eyebrow">Scaffold</p>
      <h1>Alroy Ndhlovu</h1>
      <p class="journey__blurb">
        Full-stack digital marketing, business technology and branding strategy consultant.
      </p>
    </header>

    {
      SECTIONS.map((section) => (
        <section id={section.id} class="journey__section" aria-labelledby={`${section.id}-heading`}>
          <p class="journey__number">{section.number}</p>
          <h2 id={`${section.id}-heading`}>{section.label}</h2>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .journey {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: var(--space-10) var(--space-5);
  }

  .journey__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-9);
  }

  .journey__blurb {
    font-size: var(--text-body);
    color: var(--color-text-muted);
  }

  .journey__section {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-top: 1px solid var(--color-border);
  }

  .journey__number {
    font-weight: 800;
    font-size: var(--text-h3);
    color: var(--color-accent);
  }
</style>
