---
/**
 * The journey page.
 *
 * Phase 2 puts the shell in place: the timeline nav and the six
 * two-column sections. Their right columns are intentionally empty and
 * carry a note naming the phase that fills them.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import JourneyNav from "../components/JourneyNav.astro";
import JourneySection from "../components/JourneySection.astro";
import WhoIsAlroy from "../components/WhoIsAlroy.astro";
import ExperienceList from "../components/ExperienceList.astro";
import EducationGroups from "../components/EducationGroups.astro";
import PortfolioGrid from "../components/PortfolioGrid.astro";
import ProductShowcase from "../components/ProductShowcase.astro";
import CaseStudyStack from "../components/CaseStudyStack.astro";
import ContactSection from "../components/ContactSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE, SECTIONS } from "../data/site";
---

<BaseLayout title={SITE.title} description={SITE.description} path="/">
  <JourneyNav slot="nav" />

  <header class="hero" id="top">
    <div class="hero__inner" data-reveal>
      <p class="eyebrow" data-reveal-item>Full-stack marketing, branding and business tech</p>
      <h1 data-reveal-item>Alroy Ndhlovu</h1>
      <p class="hero__blurb" data-reveal-item>
        I help businesses grow by designing high-impact solutions through data-driven marketing,
        analytics, automation, AI and creative strategy.
      </p>
    </div>
  </header>

  {
    SECTIONS.map((section) => (
      <JourneySection
        id={section.id}
        number={section.number}
        label={section.label}
        heading={section.heading}
        blurb={section.blurb}
      >
        {section.id === "who" && <WhoIsAlroy />}
        {section.id === "experience" && <ExperienceList />}
        {section.id === "education" && <EducationGroups />}
        {section.id === "portfolio" && <PortfolioGrid />}
        {section.id === "products" && <ProductShowcase />}
        {section.id === "case-studies" && <CaseStudyStack />}
        {section.id === "contact" && <ContactSection />}
      </JourneySection>
    ))
  }

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import "../scripts/journey";
  import "../scripts/portfolio";
</script>

<style>
  .hero {
    padding-top: calc(var(--nav-height-mobile) + var(--space-8));
    padding-bottom: var(--space-8);
  }

  .hero__inner {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  h1 {
    margin-top: var(--space-3);
  }

  .hero__blurb {
    margin-top: var(--space-5);
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  @media (width >= 1024px) {
    .hero {
      padding-top: calc(var(--nav-height) + var(--space-9));
      padding-bottom: var(--space-9);
    }
  }
</style>
