---
/**
 * The shell every page renders into: head/meta, font preloads,
 * global styles, and the semantic landmark structure.
 * Per-page SEO comes in as props; JSON-LD is passed as an object
 * and serialised here so pages never hand-write script tags.
 */
import { SITE } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/case-studies/hakkan/". Defaults to the current URL. */
  path?: string;
  /** Absolute or root-relative OG image. Falls back to the branded default. */
  ogImage?: string;
  /** JSON-LD graph objects, serialised into <script type="application/ld+json">. */
  schema?: Record<string, unknown>[];
  /** Set on pages that should not be indexed (currently only /404). */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = "/og-default.png",
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(path ?? Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Marks that scripting is available, before first paint, so the
      reveal animations can hide their starting state without ever
      hiding content from a visitor whose JS does not run.
    -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Both shipped cuts are used above the fold, so both are preloaded. -->
    <link
      rel="preload"
      href="/fonts/ApfelGrotezk-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ApfelGrotezk-Mittel.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      schema.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} is:inline />
      ))
    }
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot name="nav" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-accent);
    color: var(--color-invert-text);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    transform: translateY(calc(-1 * var(--space-10)));
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
