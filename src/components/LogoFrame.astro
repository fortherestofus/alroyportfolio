---
/**
 * A company or institution mark in the standard rounded frame.
 * Where no file exists yet, a Lucide glyph stands in at the same size,
 * so a row never shows a broken image or collapses.
 *
 * The mark is decorative: the name is always written next to it, so
 * repeating it as alt text would just make screen readers say it twice.
 */
import { Image } from "astro:assets";
import { Building2, GraduationCap } from "@lucide/astro";
import { logo, needsDarkBacking } from "../data/logos";

interface Props {
  file?: string;
  kind?: "company" | "institution";
  /** Case studies badge the client as a circular mark. */
  round?: boolean;
  size?: "md" | "lg";
}

const { file, kind = "company", round = false, size = "md" } = Astro.props;
const source = logo(file);
const onDark = needsDarkBacking(file);

// Rendered at 2x the 40px frame so the mark stays crisp on retina.
const RENDER_SIZE = 80;
---

<span
  class:list={["frame", round && "frame--round", size === "lg" && "frame--lg"]}
  data-on-dark={onDark ? "true" : undefined}
  aria-hidden="true"
>
  {
    source ? (
      <Image src={source} alt="" width={RENDER_SIZE} height={RENDER_SIZE} loading="lazy" />
    ) : kind === "institution" ? (
      <GraduationCap class="frame__glyph" />
    ) : (
      <Building2 class="frame__glyph" />
    )
  }
</span>

<style>
  .frame {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--frame-logo);
    height: var(--frame-logo);
    padding: var(--space-1);
    /*
     * Frames stay light on the dark page, because that is the
     * background almost every mark was drawn for: dark ink on
     * transparency, or opaque with white already behind it. The one
     * kind this cannot serve is a mark inked in white on transparency,
     * which gets the ink treatment below.
     */
    background-color: var(--color-invert-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    color: var(--color-invert-muted);
  }

  /*
   * Case studies badge the client as a circle. A round frame crops the
   * corners off a square mark, so it also gets more padding to pull the
   * artwork inside the circle rather than letting it touch the edge.
   */
  .frame--round {
    border-radius: var(--radius-pill);
    padding: var(--space-2);
  }

  .frame--lg {
    width: var(--frame-logo-lg);
    height: var(--frame-logo-lg);
  }

  .frame[data-on-dark="true"] {
    background-color: var(--color-bg);
    border-color: var(--color-border);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .frame__glyph {
    width: var(--icon-md);
    height: var(--icon-md);
    stroke-width: 1.5;
  }
</style>
