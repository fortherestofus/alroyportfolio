---
/**
 * A company or institution mark in the standard rounded frame.
 * Where no file exists yet, a Lucide glyph stands in at the same size,
 * so a row never shows a broken image or collapses.
 *
 * The mark is decorative: the name is always written next to it, so
 * repeating it as alt text would just make screen readers say it twice.
 */
import { Image } from "astro:assets";
import { Building2, GraduationCap } from "@lucide/astro";
import { logo } from "../data/logos";

interface Props {
  file?: string;
  kind?: "company" | "institution";
}

const { file, kind = "company" } = Astro.props;
const source = logo(file);

// Rendered at 2x the 40px frame so the mark stays crisp on retina.
const RENDER_SIZE = 80;
---

<span class="frame" aria-hidden="true">
  {
    source ? (
      <Image src={source} alt="" width={RENDER_SIZE} height={RENDER_SIZE} loading="lazy" />
    ) : kind === "institution" ? (
      <GraduationCap class="frame__glyph" />
    ) : (
      <Building2 class="frame__glyph" />
    )
  }
</span>

<style>
  .frame {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--frame-logo);
    height: var(--frame-logo);
    padding: var(--space-1);
    /*
     * Frames stay light on the dark page. Nearly every mark Alroy has
     * was drawn for a white background: some are dark ink on
     * transparency, some are opaque with white behind them, one is
     * white on transparency. Giving them all the background they were
     * designed for is what makes the whole set legible at once, rather
     * than maintaining a list of exceptions in both directions.
     */
    background-color: var(--color-invert-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    color: var(--color-invert-muted);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .frame__glyph {
    width: var(--icon-md);
    height: var(--icon-md);
    stroke-width: 1.5;
  }
</style>
