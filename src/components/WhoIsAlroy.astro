---
/**
 * Section 01 content: profile photo, bio, the service pills, a proof
 * row of stats and quick links, then testimonials and the client strip.
 */
import { Image } from "astro:assets";
import { Sparkles, Download, ArrowUpRight, ArrowDown } from "@lucide/astro";
import ServicePills from "./ServicePills.astro";
import FeaturedIn from "./FeaturedIn.astro";
import RailControls from "./RailControls.astro";
import LogoStrip from "./LogoStrip.astro";
import portrait from "../assets/images/Alroy-Ndhlovu-FOE.jpeg";
import { SITE, SOCIAL } from "../data/site";
import { STATS } from "../data/services";
import { TESTIMONIALS } from "../data/testimonials";

/**
 * Lucide carries no brand marks, and Simple Icons has dropped LinkedIn,
 * so a mixed set would leave one link visibly odd. Everything therefore
 * uses Lucide, per the PRD, and the label carries the identity: the
 * outbound arrow for profiles, and a meaningful glyph where one exists.
 */
/*
 * The ask-AI prompt names the domain so the assistant grounds its
 * answer on the site rather than guessing from a bare name.
 */
const ASK_PROMPT = encodeURIComponent(
  "Who is Alroy Ndhlovu (alroyndhlovu.com), the marketing, branding, business tech and product consultant? What does he do and what has he built?",
);

const QUICK_LINKS = [
  {
    label: "LinkedIn",
    href: SOCIAL.linkedin,
    icon: ArrowUpRight,
    external: true,
    track: "linkedin",
  },
  { label: "Dribbble", href: SOCIAL.dribbble, icon: ArrowUpRight, external: true },
  { label: "GitHub", href: SOCIAL.github, icon: ArrowUpRight, external: true },
  {
    label: "Ask ChatGPT",
    // ?q= prefills and submits; hints=search asks it to browse the web.
    href: `https://chatgpt.com/?q=${ASK_PROMPT}&hints=search`,
    icon: Sparkles,
    external: true,
  },
  {
    label: "Ask Gemini",
    /*
     * Google AI Mode (udm=50), not gemini.google.com/app?q= — tested:
     * the Gemini app drops the query for signed-out visitors and lands
     * them on an empty chat, while AI Mode runs it for everyone and is
     * Gemini-powered. Swap the URL if the app ever honours the param.
     */
    href: `https://www.google.com/search?udm=50&q=${ASK_PROMPT}`,
    icon: Sparkles,
    external: true,
  },
  /*
   * Two files, because they answer to two different readers. "Résumé"
   * is the ATS-safe one — single column, text only — which is what an
   * applicant tracking system can actually read. "Portfolio PDF" is the
   * visual version, for a person who will open it themselves.
   */
  {
    label: "Résumé",
    href: SITE.resume,
    icon: Download,
    external: false,
    track: "download_resume",
  },
  {
    label: "Portfolio PDF",
    href: SITE.resumeVisual,
    icon: Download,
    external: false,
    track: "download_resume_visual",
  },
];

/*
 * Shortcuts to the sections a hirer usually wants first. The nav lists
 * all seven, but on a phone it shows two or three at a time, and this
 * section is long; five direct routes under the bio save the scroll.
 * Not all seven, which would only repeat the nav.
 */
const JUMPS = [
  { id: "experience", label: "Work experience" },
  { id: "portfolio", label: "Portfolio" },
  { id: "products", label: "Products" },
  { id: "case-studies", label: "Case studies" },
  { id: "contact", label: "Book a call" },
];

// Rendered at 2x the 160px frame for retina.
const PORTRAIT_SIZE = 320;
---

<div class="who">
  <div class="who__intro" data-reveal>
    <Image
      class="who__portrait"
      src={portrait}
      alt="Alroy Ndhlovu"
      width={PORTRAIT_SIZE}
      height={PORTRAIT_SIZE}
      loading="eager"
      fetchpriority="high"
      data-reveal-item
    />

    <p class="who__bio" data-reveal-item>
      Twelve-plus years of training and experience across marketing, brand building, media and
      content, product, and business optimisation and automation technology. I've worked with brands
      and organisations including Meta, Total Sports, Jenna Clifford, IAB South Africa, the IFC,
      Energy Capital &amp; Power, Innovatr, Digify, Zimbabwe Tourism, English Plus Academy and the
      African Agri Council, architecting business and product solutions, strengthening brand
      presence and driving profitability through data-driven, audience-focused work.
    </p>
  </div>

  <nav class="who__jump" aria-label="Jump to a section" data-reveal>
    <span class="who__jump-label">Jump to</span>
    <ul class="who__jump-list">
      {
        JUMPS.map((jump) => (
          <li>
            <a class="who__jump-link" href={`#${jump.id}`} data-jump>
              {jump.label}
              <ArrowDown class="who__jump-icon" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="who__block" data-reveal>
    <h3 class="who__subheading">What I do</h3>
    <ServicePills />
  </div>

  <div class="who__block" data-reveal>
    <dl class="who__stats">
      {
        STATS.map((stat) => (
          <div class="who__stat" data-reveal-item>
            <dt class="who__stat-value">{stat.value}</dt>
            <dd class="who__stat-label">{stat.label}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="who__links">
      {
        QUICK_LINKS.map((link) => (
          <li>
            <a
              class="who__link"
              href={link.href}
              data-track={link.track}
              {...(link.external
                ? { target: "_blank", rel: "noopener noreferrer" }
                : { download: true })}
            >
              <link.icon class="who__link-icon" aria-hidden="true" />
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {
    /*
     * The two proof blocks run as rails rather than stacks: three
     * testimonials and three recognition cards stacked were most of the
     * section's height. One quote per view with a count, and a row of
     * cards that peeks the next one. Neither moves on its own.
     */
  }
  <section class="who__block" aria-labelledby="who-quotes" data-reveal data-rail>
    <div class="who__head">
      <h3 class="who__subheading" id="who-quotes">What people say</h3>
      <RailControls label="testimonial" count />
    </div>
    <ul class="who__quotes" data-rail-track tabindex="0" aria-label="Testimonials">
      {
        TESTIMONIALS.map((testimonial, index) => (
          <li class="who__quote" aria-label={`${index + 1} of ${TESTIMONIALS.length}`}>
            <blockquote>
              <p>{testimonial.quote}</p>
            </blockquote>
            <p class="who__attribution">
              <span class="who__quote-name">{testimonial.name}</span>
              <span class="who__quote-role">
                {testimonial.role}, {testimonial.organisation}
              </span>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    /*
     * "Recognition" rather than "Featured in" or "As seen on": those
     * labels mean press logos, and only one of these is press. See
     * src/data/features.ts.
     */
  }
  <section class="who__block" aria-labelledby="who-recognition" data-reveal data-rail>
    <div class="who__head">
      <h3 class="who__subheading" id="who-recognition">Recognition</h3>
      <RailControls label="item" />
    </div>
    <FeaturedIn />
  </section>

  <div class="who__block" data-reveal>
    <LogoStrip />
  </div>
</div>

<style>
  .who {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .who__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .who__portrait {
    width: var(--avatar-profile-sm);
    height: var(--avatar-profile-sm);
    border-radius: var(--radius-pill);
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  .who__bio {
    color: var(--color-text-muted);
  }

  .who__subheading {
    font-size: var(--text-h3);
    margin-bottom: var(--space-4);
  }

  /* Heading left, rail controls right. */
  .who__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .who__head .who__subheading {
    margin-bottom: 0;
  }

  /* --- Jump links ------------------------------------------- */
  .who__jump {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: calc(-1 * var(--space-4));
  }

  .who__jump-label {
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    font-weight: var(--weight-heading);
    color: var(--color-text-faint);
  }

  .who__jump-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .who__jump-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--control-md);
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    color: var(--color-accent);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .who__jump-link:hover,
  .who__jump-link:focus-visible {
    border-bottom-color: var(--color-accent);
  }

  .who__jump-icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
    stroke-width: 2;
  }

  /* --- Proof row -------------------------------------------- */
  .who__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
    margin: 0;
  }

  .who__stat-value {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
    color: var(--color-accent);
  }

  .who__stat-label {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .who__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .who__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-md);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    color: var(--color-text-muted);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      translate var(--duration-fast) var(--ease-out);
  }

  .who__link:hover,
  .who__link:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
    translate: 0 -2px;
  }

  .who__link-icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
    stroke-width: 2;
  }

  /* --- Testimonials ----------------------------------------- */
  /*
   * One quote per view. A native scroll-snap row, so swipe, trackpad
   * and arrow keys work without the script; the buttons are extra. No
   * shadow on these cards: the scroll container would clip it.
   */
  .who__quotes {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-radius: var(--radius-card);
  }

  .who__quotes::-webkit-scrollbar {
    display: none;
  }

  .who__quotes:focus-visible {
    outline-offset: var(--space-1);
  }

  .who__quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 0 0 100%;
    scroll-snap-align: start;
    padding: var(--space-5);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .who__quote blockquote {
    margin: 0;
  }

  .who__quote blockquote p {
    color: var(--color-text);
  }

  .who__attribution {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-4);
    font-size: var(--text-small);
  }

  .who__quote-name {
    font-weight: var(--weight-heading);
  }

  .who__quote-role {
    color: var(--color-text-muted);
  }

  @media (width >= 768px) {
    .who__intro {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-6);
    }

    .who__portrait {
      width: var(--avatar-profile);
      height: var(--avatar-profile);
    }
  }
</style>
