---
/**
 * The layered cards, used twice: section 05 (products) and section 06
 * (client case studies, PRD §6.05).
 *
 * Cards stack and peel as you scroll, matching
 * `screenshots/case study overview (must be scrollable stacked cards).jpg`.
 *
 * Every card sticks at the same point, so each one arrives directly over
 * the one before it: the reader looks at one item at a time, in one
 * place, and scrolling moves between them rather than past them.
 *
 * Products moved onto this from a long column of full write-ups (about
 * 4,700px for four products, 7 Nov 2026). A card here is a preview,
 * not the record: the problem, the approach, the stack and the store
 * link all live on the product's own page, which the card links to.
 *
 * `position: sticky`, not a ScrollTrigger pin, for the same reasons the
 * two-column pin is (see JourneySection): no pin-spacer, so no jump at
 * the section boundary, no refresh needed on resize, and it still works
 * with JS off.
 *
 * Cards must be opaque for this to read at all — a translucent card
 * would show the one it is covering straight through.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import Placeholder from "./Placeholder.astro";
import LogoFrame from "./LogoFrame.astro";
import {
  CLIENT_STUDIES,
  UPCOMING_STUDIES,
  caseImage,
  studyPath,
  type Focus,
} from "../data/case-studies";
import { PRODUCTS, productImage, caseStudyLink } from "../data/products";

interface Props {
  kind: "studies" | "products";
}

const { kind } = Astro.props;

type Shape = "screen" | "phone" | "panel";

interface StackItem {
  name: string;
  logoFile?: string;
  /** Top right of the card: the dates, or a product's status. */
  meta: string;
  summary: string;
  /** One measured line under the summary, where there is one. */
  proof?: string;
  tags: string[];
  description: string;
  /** The dark pill: the page this card is a preview of. */
  cta?: { label: string; href: string };
  /** A quieter way out, to somewhere off the site. */
  external?: { label: string; href: string };
  focus?: Focus[];
  shape: Shape;
  strip: { image: ImageMetadata | null | undefined; label: string }[];
}

/*
 * Enough shots in one copy of a strip to run past the edge of the card.
 * A strip shorter than its viewport shows a gap at the end of every
 * loop, and four phone captures are well short of a card's width.
 */
const MIN_PER_COPY: Record<Shape, number> = { phone: 8, panel: 5, screen: 3 };
const fill = <T,>(list: T[], shape: Shape): T[] => {
  if (list.length === 0) return list;
  const out = [...list];
  while (out.length < MIN_PER_COPY[shape]) out.push(...list);
  return out;
};

const items: StackItem[] =
  kind === "studies"
    ? CLIENT_STUDIES.map((study) => ({
        name: study.name,
        logoFile: study.logoFile,
        meta: study.dates,
        summary: study.summary,
        tags: study.tags,
        description: study.description,
        cta: { label: "case study", href: studyPath(study) },
        focus: study.focus,
        shape: "screen",
        strip: (study.strip ?? []).map((shot) => ({
          image: caseImage(shot.image),
          label: shot.image,
        })),
      }))
    : PRODUCTS.map((product) => {
        const story = caseStudyLink(product.caseStudy);
        return {
          name: product.name,
          meta: `${product.status} · ${product.platform}`,
          summary: product.tagline,
          proof: product.proof,
          tags: [product.category, ...product.stack.slice(0, 3)],
          description: product.description,
          cta: story ? { label: "how it was built", href: story } : undefined,
          external: product.link
            ? { label: product.link.label, href: product.link.url }
            : undefined,
          shape: product.shape,
          strip: fill(
            product.shots.map((shot) => ({
              image: productImage(shot.image),
              label: `products/${shot.image}`,
            })),
            product.shape,
          ),
        };
      });

/*
 * The filter, so a hirer for one discipline reaches their proof first.
 * Case studies only: four products need no sorting. Hidden until the
 * script runs: without it the buttons would do nothing.
 */
const FILTERS: { id: "all" | Focus; label: string }[] = [
  { id: "all", label: "All" },
  { id: "brand", label: "Brand" },
  { id: "product", label: "Product" },
  { id: "marketing", label: "Marketing" },
];
const count = (id: "all" | Focus) =>
  id === "all" ? items.length : items.filter((item) => item.focus?.includes(id)).length;

/*
 * Strip shots are small and never shown large. Case study shots are
 * sized for the short screen-shaped strip; product strips run taller,
 * because a phone capture at that height would be a sliver.
 */
const STRIP_HEIGHT = kind === "products" ? 440 : 320;
const STRIP_QUALITY = 70;
---

{
  kind === "studies" && (
    <div
      class="stack-filter"
      role="group"
      aria-label="Filter case studies"
      data-stack-filter
      hidden
    >
      {FILTERS.map((filter, index) => (
        <button
          type="button"
          class="stack-filter__pill"
          data-filter={filter.id}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {filter.label}
          <span class="stack-filter__count">{count(filter.id)}</span>
        </button>
      ))}
    </div>
  )
}

<div class:list={["stack", `stack--${kind}`]}>
  {
    items.map((item) => (
      <article
        class:list={["stack__card", !item.strip.length && "stack__card--no-strip"]}
        data-focus={(item.focus ?? []).join(" ")}
        data-reveal
      >
        <header class="stack__head">
          <p class="stack__project">
            {item.logoFile && <LogoFrame file={item.logoFile} round />}
            <span>[ {item.name} ]</span>
          </p>
          <p class="stack__dates">[ {item.meta} ]</p>
        </header>

        <div class="stack__body">
          <div class="stack__lead">
            <h3 class="stack__summary" data-reveal-item>
              {item.summary}
            </h3>
            {item.proof && (
              <p class="stack__proof" data-reveal-item>
                {item.proof}
              </p>
            )}
            <ul class="stack__tags" data-reveal-item>
              {item.tags.map((tag) => (
                <li class="stack__tag">{tag}</li>
              ))}
            </ul>
          </div>

          <div class="stack__side" data-reveal-item>
            <p class="stack__descriptor">{item.description}</p>
            <p class="stack__actions">
              {item.cta && (
                <a class="stack__cta" href={item.cta.href}>
                  {item.cta.label}
                  <ArrowUpRight class="stack__cta-icon" aria-hidden="true" />
                </a>
              )}
              {item.external && (
                <a
                  class="stack__external"
                  href={item.external.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.external.label}
                  <ArrowUpRight class="stack__external-icon" aria-hidden="true" />
                </a>
              )}
            </p>
          </div>
        </div>

        {/*
         * The strip is decorative: every shot on it appears again, with
         * a real caption, on the page the card links to. Rendering it
         * twice makes the loop seamless, and the whole thing is hidden
         * from assistive tech rather than read out as sixteen unlabelled
         * images between the summary and the link.
         */}
        <div class="stack__viewport" aria-hidden="true" hidden={!item.strip.length}>
          <div class:list={["stack__track", `stack__track--${item.shape}`]}>
            {[0, 1].map((copy) =>
              item.strip.map((shot) => (
                <span class="stack__shot" data-copy={copy}>
                  {shot.image ? (
                    <Image
                      src={shot.image}
                      alt=""
                      height={STRIP_HEIGHT}
                      quality={STRIP_QUALITY}
                      densities={[1]}
                      loading="lazy"
                    />
                  ) : (
                    <Placeholder label={shot.label} ratio="16/10" />
                  )}
                </span>
              )),
            )}
          </div>
        </div>
      </article>
    ))
  }

  {
    kind === "studies" && UPCOMING_STUDIES.length > 0 && (
      <aside class="stack__upcoming" data-reveal>
        <p class="eyebrow">Being written</p>
        <ul class="stack__upcoming-list">
          {UPCOMING_STUDIES.map((study) => (
            <li class="stack__upcoming-item">
              <span class="stack__upcoming-name">{study.name}</span>
              <span class="stack__upcoming-note">{study.note}</span>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</div>

<style>
  .stack-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .stack-filter[hidden] {
    display: none;
  }

  .stack-filter__pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-md);
    padding-inline: var(--space-4);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    color: var(--color-text-muted);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .stack-filter__pill:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .stack-filter__pill[aria-pressed="true"] {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: var(--color-accent-soft);
  }

  .stack-filter__count {
    font-size: var(--text-chip);
    color: var(--color-text-muted);
  }

  .stack__card[hidden] {
    display: none;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    /*
     * Set by the script to the tallest card's natural height. Declared
     * here so the value has a home, and so the stack still renders
     * sensibly if the script never runs.
     */
    --stack-card-h: auto;
  }

  .stack__card {
    /*
     * Opaque, and raised off the page, so a card visibly covers the one
     * it is peeling over.
     */
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-block);
    box-shadow: var(--shadow-card);
    /*
     * No bottom padding: the strip runs to the card's edge on purpose.
     * A card with no strip has to put it back, or the last thing in the
     * card — the tags, or the case study button — sits flush against
     * the rounded corner.
     */
    padding: var(--space-5) var(--space-5) 0;
    overflow: hidden;
  }

  .stack__card--no-strip {
    padding-bottom: var(--space-5);
  }

  .stack__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-small);
    color: var(--color-text-faint);
  }

  .stack__project {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .stack__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    /*
     * Deliberately tighter than the section rhythm elsewhere. Every
     * pixel of card height is a pixel of viewport the peel needs before
     * it can engage at all (see the fit test in the script), and the
     * gap between a card's own header and its own summary is the
     * cheapest place to find them.
     */
    margin-top: var(--space-6);
  }

  /*
   * The card lives in the 7/12 column, not the full page width, so the
   * summary is sized against the column it is actually in. At --text-h2
   * this line ran to nine lines and swallowed the card.
   */
  .stack__summary {
    /*
     * h4, not h3. These summaries are whole sentences, and at h3 the
     * longest ran to five lines — enough on its own to push the card
     * past the height the peel needs (see the fit test in the script).
     */
    font-size: var(--text-h4);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .stack__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .stack__tag {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-sm);
    padding-inline: var(--space-3);
    background-color: var(--color-accent-soft);
    border-radius: var(--radius-pill);
    font-size: var(--text-chip);
    color: var(--color-accent);
    white-space: nowrap;
  }

  /* The measured line on a product card: what it has actually done. */
  .stack__proof {
    margin-top: var(--space-3);
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    color: var(--color-accent);
  }

  .stack__descriptor {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .stack__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
  }

  /* Off-site, so quieter than the pill: a text link with the same arrow. */
  .stack__external {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--control-md);
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    color: var(--color-accent);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .stack__external:hover,
  .stack__external:focus-visible {
    border-bottom-color: var(--color-accent);
  }

  .stack__external-icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
    stroke-width: 2;
  }

  .stack__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-lg);
    padding-inline: var(--space-5);
    background-color: var(--color-invert-surface);
    color: var(--color-invert-text);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .stack__cta:hover,
  .stack__cta:focus-visible {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .stack__cta-icon {
    width: var(--icon-md);
    height: var(--icon-md);
    stroke-width: 2;
  }

  /* --- Moving strip -------------------------------------------- */
  .stack__viewport {
    margin-top: var(--space-6);
    overflow: hidden;
    /*
     * The strip runs off both edges of the card rather than stopping
     * inside it, which is what makes it read as moving rather than as a
     * row of thumbnails.
     */
    margin-inline: calc(-1 * var(--space-5));
    mask-image: linear-gradient(
      to right,
      transparent,
      black var(--space-6),
      black calc(100% - var(--space-6)),
      transparent
    );
  }

  .stack__track {
    display: flex;
    gap: var(--space-3);
    width: max-content;
    padding-inline: var(--space-3);
    padding-bottom: var(--space-5);
    animation: stack-scroll 60s linear infinite;
  }

  .stack__viewport:hover .stack__track {
    animation-play-state: paused;
  }

  .stack__shot {
    display: block;
    flex: none;
    width: var(--shot-strip-width-compact);
    aspect-ratio: var(--shot-screen-ratio);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
  }

  /*
   * Same rule as the product rails: a fixed frame, and the image fills
   * it. `cover` here rather than `contain` because a strip of
   * letterboxed thumbnails at this size is mostly background.
   */
  .stack__shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .stack__shot :global(.placeholder) {
    height: 100%;
  }

  /*
   * Product strips: one height for every shape, so a card of phone
   * captures and a card of browser captures level to the same size,
   * and each frame takes the shape of the thing it shows.
   */
  .stack--products .stack__shot {
    width: auto;
    height: var(--shot-strip-product-height);
  }

  .stack__track--phone .stack__shot {
    aspect-ratio: var(--shot-phone-ratio);
  }

  .stack__track--panel .stack__shot {
    aspect-ratio: var(--shot-panel-ratio);
  }

  @keyframes stack-scroll {
    to {
      /* Exactly one copy of the list, so the seam is invisible. */
      translate: -50% 0;
    }
  }

  /* --- Studies still being written ----------------------------- */
  .stack__upcoming {
    /*
     * Opaque for the same reason the cards are: this scrolls up over
     * the last pinned card, and a transparent panel would let that
     * card's summary read straight through this one's text.
     */
    position: relative;
    background-color: var(--color-bg);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .stack__upcoming-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .stack__upcoming-item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-small);
  }

  .stack__upcoming-name {
    font-weight: var(--weight-heading);
  }

  .stack__upcoming-note {
    color: var(--color-text-faint);
  }

  @media (width >= 640px) {
    .stack__card {
      padding: var(--space-5) var(--space-6) 0;
    }

    .stack__card--no-strip {
      padding-bottom: var(--space-6);
    }

    .stack__viewport {
      margin-inline: calc(-1 * var(--space-6));
    }

    .stack__body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-6);
      align-items: end;
    }

    .stack__side {
      text-align: right;
    }

    .stack__actions {
      justify-content: flex-end;
    }
  }

  /*
   * The peel. Only above 1024px, where the two-column layout means
   * there is a tall enough column for a stack to build; on a phone the
   * cards are nearly viewport-height already and pinning them would
   * trap the reader in the section.
   */
  @media (width >= 1024px) {
    /*
     * Every card sticks at the same point, so each one arrives directly
     * over the last and the section reads as a single frame changing
     * its contents rather than a column of cards going past.
     *
     * An earlier version staggered the offset by card index, which
     * fanned them downwards and left every previous card's top edge
     * showing. That is a different effect, and not the one this
     * section is for: the reader should be looking at one case study at
     * a time, in one place, and moving between them.
     *
     * The gap goes with it. Any space between cards is a gap the reader
     * scrolls through before the next card covers the last, which
     * breaks the illusion that one is replacing the other.
     */
    .stack:not(.stack--flat) {
      gap: 0;
    }

    .stack__card {
      position: sticky;
      top: calc(var(--nav-height) + var(--space-4));
    }

    /*
     * One height for all of them. Cards stick at the same point, so a
     * short card landing on top of a tall one leaves the tall one's
     * bottom sticking out underneath — the stack looks broken rather
     * than layered. Levelling them to the tallest is what makes each
     * card cover the last exactly.
     */
    .stack:not(.stack--flat) .stack__card {
      min-height: var(--stack-card-h);
    }
  }

  /*
   * Cards that cannot fit under their own pin point do not pin at all.
   *
   * A pinned card taller than the space beneath it can never show its
   * bottom edge, so its "case study" link sits below the fold at every
   * scroll position — permanently unclickable. This used to be a
   * hardcoded `height <= 760px` media query, which was a guess at the
   * content's height rather than a measurement of it: it flattened the
   * stack on plenty of laptops that could have shown it, and it would
   * have gone on being wrong the moment a longer summary made a card
   * taller. The script below measures the real thing and sets this
   * class, so the peel appears exactly when it actually works.
   */
  .stack--flat .stack__card {
    position: static;
  }

  /*
   * The middle setting. Before giving up on the peel entirely, the
   * script drops the moving strip — the tallest thing a card carries
   * and the only part of it that is purely decorative. On a laptop
   * that cannot fit a full card under its pin point, a stack that
   * actually stacks is worth more than a row of thumbnails inside a
   * card that does not.
   */
  .stack--compact .stack__viewport {
    display: none;
  }

  .stack--compact .stack__card {
    padding-bottom: var(--space-5);
  }

  @media (width >= 640px) {
    .stack--compact .stack__card {
      padding-bottom: var(--space-6);
    }
  }

  /*
   * Reduced motion: no marquee, and no stacking either. Cards that pin
   * and slide over each other are exactly the kind of scroll-coupled
   * movement the preference is asking us not to do.
   */
  @media (prefers-reduced-motion: reduce) {
    .stack__track {
      animation: none;
    }

    .stack__viewport {
      overflow-x: auto;
    }

    .stack__card {
      position: static;
    }
  }
</style>

<script>
  /*
   * Decide whether the peel can actually work here, for each stack on
   * the page (products and case studies) on its own.
   *
   * The cards pin at `--nav-height + --space-4`, so a card taller than
   * the room beneath that point can never show its bottom — and the
   * link that is the whole point of the card — so the stack falls back
   * to ordinary scrolling.
   *
   * Measured rather than assumed: card height depends on how long a
   * given summary happens to be, which is content, not layout, and the
   * media query this replaces could only ever guess at it.
   */
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const wide = window.matchMedia("(width >= 1024px)");

  /*
   * Levelling the cards changes how tall the page is, and this can
   * happen well after load — the first honest measurement is only
   * available once the real typeface has replaced the fallback.
   * Anything holding cached scroll geometry (the timeline nav, and
   * ScrollTrigger behind it) is then measuring a page that no longer
   * exists, and scrubbing lands in the wrong place.
   *
   * So when the layout actually changes, say so. A resize event is the
   * signal every scroll library already listens for. `syncing` stops
   * the event this dispatches from re-entering the handler that
   * dispatched it.
   */
  let syncing = false;

  function setUp(stack: HTMLElement) {
    const cards = [...stack.querySelectorAll<HTMLElement>(".stack__card")];
    if (cards.length === 0) return;
    const last = cards[cards.length - 1];

    /**
     * Measure the stack at its natural size and report both whether it
     * fits and how tall its tallest card is.
     *
     * The level-up height has to be cleared before measuring or the
     * measurement feeds on its own output: every card would report the
     * height set on the last pass and the value could only ever grow.
     */
    const measure = () => {
      stack.classList.remove("stack--flat");
      stack.style.setProperty("--stack-card-h", "auto");
      void stack.offsetHeight;

      /*
       * Read the pin offset off the element rather than recomputing the
       * `top` calc here. Duplicating that formula in JS is a bug waiting
       * to happen — it already happened once, when the offsets were
       * tightened in CSS and this test carried on measuring against the
       * old ones, refusing to peel on viewports that had room to spare.
       */
      const top = Number.parseFloat(getComputedStyle(last).top) || 0;
      const visible = cards.filter((card) => !card.hidden);
      const tallest = Math.max(...visible.map((card) => card.getBoundingClientRect().height));
      const air = Number.parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue("--space-4"),
      );

      return { fits: top + tallest + air <= window.innerHeight, tallest };
    };

    const signature = () => `${stack.className}|${stack.style.getPropertyValue("--stack-card-h")}`;

    const notifyIfChanged = (before: string) => {
      if (signature() === before || syncing) return;
      syncing = true;
      window.dispatchEvent(new Event("resize"));
      syncing = false;
    };

    /*
     * Three settings, tried in order, so the peel survives a short
     * window instead of being switched off by one.
     *
     * Full card first. If that cannot fit under the pin point, drop the
     * decorative strip and try again — that is worth about two hundred
     * pixels and costs nothing the page needs. Only if a card still
     * cannot show its own link does the stack give up and scroll like
     * everything else.
     */
    const apply = () => {
      if (!wide.matches || reduced.matches) {
        const was = signature();
        stack.classList.add("stack--flat");
        stack.classList.remove("stack--compact");
        stack.style.setProperty("--stack-card-h", "auto");
        notifyIfChanged(was);
        return;
      }

      const settle = (tallest: number) => {
        stack.classList.remove("stack--flat");
        stack.style.setProperty("--stack-card-h", `${Math.ceil(tallest)}px`);
      };

      const before = signature();

      stack.classList.remove("stack--compact");
      let result = measure();
      if (result.fits) settle(result.tallest);
      else {
        stack.classList.add("stack--compact");
        result = measure();
        if (result.fits) settle(result.tallest);
        else {
          stack.classList.remove("stack--compact");
          stack.classList.add("stack--flat");
          stack.style.setProperty("--stack-card-h", "auto");
        }
      }

      notifyIfChanged(before);
    };

    apply();

    /*
     * The discipline filter, which sits directly before the stack it
     * sorts. Hiding cards changes how tall the stack is, so it re-runs
     * the same levelling and says so with a resize, exactly as a font
     * swap does.
     */
    const filter = stack.previousElementSibling;
    if (filter instanceof HTMLElement && filter.matches("[data-stack-filter]")) {
      const pills = [...filter.querySelectorAll<HTMLButtonElement>("[data-filter]")];
      filter.hidden = false;
      pills.forEach((pill) =>
        pill.addEventListener("click", () => {
          const chosen = pill.dataset.filter ?? "all";
          pills.forEach((other) => other.setAttribute("aria-pressed", String(other === pill)));
          cards.forEach((card) => {
            const focus = (card.dataset.focus ?? "").split(" ");
            card.hidden = chosen !== "all" && !focus.includes(chosen);
          });
          apply();
          window.dispatchEvent(new Event("resize"));
        }),
      );
    }

    /*
     * Re-measure on resize, and once fonts have settled: a card's height
     * changes when the real typeface replaces the fallback, and
     * measuring before that reports a height the card never has.
     */
    let frame = 0;
    window.addEventListener("resize", () => {
      if (syncing) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(apply);
    });
    document.fonts?.ready.then(apply);
  }

  document.querySelectorAll<HTMLElement>(".stack").forEach(setUp);
</script>
