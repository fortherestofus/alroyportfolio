---
/**
 * Section 04, in two layers.
 *
 * Projects first: the featured bodies of work, each a card linking to
 * its own page, because a reviewer gives a portfolio seconds and the
 * strongest, most complete work should be the first thing they meet.
 * The rest of the projects are a link away on /work/.
 *
 * Then the same work by medium: small cards that open the modal
 * carousel, for someone who wants every photograph or every site
 * without going project by project.
 */
import { ArrowUpRight, ArrowRight } from "@lucide/astro";
import WorkTile from "./WorkTile.astro";
import MediumCards from "./MediumCards.astro";
import PortfolioModal from "./PortfolioModal.astro";
import { FEATURED_WORK, WORK } from "../data/work";
import { SOCIAL } from "../data/site";

/* Two across, in the 7/12 column on a laptop and the full width on a phone. */
const TILE_SIZES = "(min-width: 64rem) 21rem, 45vw";
const CARD_SIZES = "(min-width: 64rem) 13.5rem, (min-width: 40rem) 30vw, 45vw";
---

<div class="work" data-reveal>
  <h3 class="work__subhead">Projects</h3>
  <ul class="work__projects">
    {
      FEATURED_WORK.map((project) => (
        <li data-reveal-item>
          <WorkTile project={project} sizes={TILE_SIZES} />
        </li>
      ))
    }
  </ul>

  <p class="work__all">
    <a href="/work/">
      All {WORK.length} projects
      <ArrowRight class="work__icon" aria-hidden="true" />
    </a>
  </p>

  <h3 class="work__subhead work__subhead--medium">By medium</h3>
  <MediumCards sizes={CARD_SIZES} />

  <p class="work__cta">
    <a href={SOCIAL.dribbble} target="_blank" rel="noopener noreferrer">
      See more on Dribbble
      <ArrowUpRight class="work__icon" aria-hidden="true" />
    </a>
  </p>
</div>

<PortfolioModal />

<style>
  .work__subhead {
    margin-bottom: var(--space-5);
    font-size: var(--text-eyebrow);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .work__subhead--medium {
    margin-top: var(--space-8);
  }

  /* Two across even on a phone: one per row made the section a long scroll. */
  .work__projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .work__all,
  .work__cta {
    margin-top: var(--space-6);
  }

  .work__all a,
  .work__cta a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-md);
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    color: var(--color-accent);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  /* The way to the rest of the projects is a real button-sized target. */
  .work__all a {
    padding-inline: var(--space-5);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .work__all a:hover,
  .work__all a:focus-visible {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .work__cta a:hover,
  .work__cta a:focus-visible {
    border-bottom-color: var(--color-accent);
  }

  .work__icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
    stroke-width: 2;
  }
</style>
