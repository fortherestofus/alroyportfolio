---
/**
 * "Recognition": the press, programme and exhibition cards in section
 * 01, between the testimonials and the client marquee.
 *
 * A horizontal rail of fixed-width cards that peeks the next one. The
 * column is about 640px, so three across would leave each card 200px,
 * too narrow for its line; stacked, the three were a screen of height
 * on their own. The rail behaviour lives in src/scripts/rail.ts and the
 * buttons in the heading row above (WhoIsAlroy).
 *
 * The whole card is the target. The anchor wraps the outlet name so the
 * accessible name is the publication rather than "read more", and a
 * stretched pseudo-element gives a pointer the full card to hit — one
 * link per card, so nothing is announced twice.
 */
import { ArrowUpRight } from "@lucide/astro";
import { FEATURES } from "../data/features";
---

<ul class="feat" data-rail-track tabindex="0" aria-label="Recognition">
  {
    FEATURES.map((feature) => (
      <li class="feat__card" data-reveal-item>
        <div class="feat__head">
          <h4 class="feat__outlet">
            <a class="feat__link" href={feature.href} target="_blank" rel="noopener noreferrer">
              {feature.outlet}
              <ArrowUpRight class="feat__icon" aria-hidden="true" />
            </a>
          </h4>

          <p class="feat__meta">
            <span class="feat__kind">{feature.kind}</span>
            <span class="feat__year">{feature.year}</span>
          </p>
        </div>

        <p class="feat__what">{feature.what}</p>
      </li>
    ))
  }
</ul>

<style>
  .feat {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-radius: var(--radius-card);
  }

  .feat::-webkit-scrollbar {
    display: none;
  }

  .feat:focus-visible {
    outline-offset: var(--space-1);
  }

  /* No shadow: the scroll container would clip it. */
  .feat__card {
    position: relative;
    flex: 0 0 var(--rail-card-width);
    max-width: 85%;
    scroll-snap-align: start;
    padding: var(--space-5);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .feat__card:has(.feat__link:hover),
  .feat__card:has(.feat__link:focus-visible) {
    border-color: var(--color-accent);
  }

  /* Narrow cards: the outlet, then its kind and year beneath. */
  .feat__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .feat__outlet {
    font-size: var(--text-h4);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
  }

  /*
   * The ::after below hands the whole card to the pointer, so the real
   * hit area was always card-sized. The element's own box was not, and
   * that is what an audit measures — so it carries the minimum itself
   * rather than relying on a pseudo-element an automated check cannot
   * see. Centred, because the extra height goes above and below a
   * baseline-aligned row and would otherwise sit the outlet name off
   * the meta line beside it.
   */
  .feat__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
    gap: var(--space-2);
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .feat__link:hover,
  .feat__link:focus-visible {
    color: var(--color-accent);
  }

  /* Gives the pointer the whole card without a second link in the tree. */
  .feat__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .feat__icon {
    flex: none;
    width: var(--icon-sm);
    height: var(--icon-sm);
    stroke-width: 2;
    /* Baseline alignment puts the arrow slightly low against caps. */
    translate: 0 0.15em;
  }

  .feat__meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /*
   * The honest label, and the reason this is not a logo wall: an
   * article, a programme and an exhibition are three different claims,
   * and each card says which one it is making.
   */
  .feat__kind {
    font-weight: var(--weight-heading);
    color: var(--color-accent);
  }

  .feat__year {
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
  }

  .feat__what {
    margin-top: var(--space-3);
    max-width: var(--measure);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }
</style>
