---
/**
 * Section 02: the roles as a vertical timeline, most recent first.
 * Rows stagger in on scroll via the shared reveal mechanism.
 */
import { ArrowUpRight } from "@lucide/astro";
import LogoFrame from "./LogoFrame.astro";
import { EXPERIENCE } from "../data/experience";
---

<ol class="roles" data-reveal>
  {
    EXPERIENCE.map((role) => (
      <li class="roles__row" data-reveal-item>
        <LogoFrame file={role.logoFile} kind="company" />

        <div class="roles__body">
          <h3 class="roles__title">{role.title}</h3>
          <p class="roles__company">
            {role.company}
            {role.employment && <span class="roles__employment">{role.employment}</span>}
          </p>
          {role.note && <p class="roles__note">{role.note}</p>}
          {role.highlights && (
            <ul class="roles__highlights">
              {role.highlights.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          )}
          {role.skills && (
            <ul class="roles__skills" aria-label={`Skills used at ${role.company}`}>
              {role.skills.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          )}
          {role.work && (
            <ul class="roles__work" aria-label={`Work from ${role.company}`}>
              {role.work.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(/^https?:/.test(link.href)
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {link.label}
                    <ArrowUpRight class="roles__work-icon" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <p class="roles__dates">{role.dates}</p>
      </li>
    ))
  }
</ol>

<style>
  .roles {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roles__row {
    display: grid;
    grid-template-columns: var(--frame-logo) minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .roles__row:first-child {
    padding-top: 0;
  }

  .roles__row:last-child {
    border-bottom: none;
  }

  .roles__title {
    font-size: var(--text-body);
    font-weight: var(--weight-heading);
    line-height: var(--leading-small);
  }

  /*
   * Quiet by design. The engagement type is context for the dates, not
   * a headline — it answers "why so many roles" without competing with
   * the role itself.
   */
  .roles__employment {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-sm);
    margin-left: var(--space-2);
    padding-inline: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-chip);
    font-size: var(--text-eyebrow);
    color: var(--color-text-faint);
    white-space: nowrap;
    vertical-align: middle;
  }

  .roles__company {
    margin-top: var(--space-1);
    font-size: var(--text-small);
    color: var(--color-accent);
  }

  .roles__note {
    margin-top: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .roles__highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: var(--space-3) 0 0;
    padding-left: var(--space-4);
    list-style: disc;
    font-size: var(--text-small);
    line-height: var(--leading-small);
    color: var(--color-text-muted);
    max-width: var(--measure);
  }

  .roles__highlights li::marker {
    color: var(--color-accent);
  }

  /*
   * The keywords, set as one quiet line rather than a row of chips:
   * there to be read by a recruiter skimming and matched by a search
   * engine, without outweighing the sentences above them.
   */
  .roles__skills {
    display: flex;
    flex-wrap: wrap;
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-eyebrow);
    line-height: var(--leading-small);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-faint);
    max-width: var(--measure);
  }

  /* Trailing, so a wrapped line never starts with a stray dot. */
  .roles__skills li:not(:last-child)::after {
    content: "·";
    padding-inline: var(--space-2);
  }

  /*
   * Small type, full-size targets: each link keeps the 44px control
   * height so a thumb can hit it, without looking like a button row.
   */
  .roles__work {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .roles__work a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--control-md);
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    color: var(--color-accent);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .roles__work a:hover,
  .roles__work a:focus-visible {
    border-bottom-color: var(--color-accent);
  }

  .roles__work-icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
    stroke-width: 2;
  }

  .roles__dates {
    /* Under the text on narrow screens, in its own column when there is room. */
    grid-column: 2;
    margin-top: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (width >= 640px) {
    .roles__row {
      grid-template-columns: var(--frame-logo) minmax(0, 1fr) auto;
      align-items: start;
      gap: var(--space-5);
    }

    .roles__dates {
      grid-column: 3;
      margin-top: 0;
      text-align: right;
    }
  }
</style>
