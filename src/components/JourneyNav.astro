---
/**
 * The journey timeline nav (PRD §5.1).
 *
 * Underneath it is a plain ordered list of anchor links, so keyboard
 * and screen reader users get the whole nav without any JS. The line,
 * pegs and drag knob are decorative enhancements layered on top and
 * are hidden from assistive tech; `journey.ts` positions them.
 *
 * Below 1024px the track is dropped entirely and the same list becomes
 * a horizontally scrollable pill bar (no drag, tap to jump).
 */
import { MoveHorizontal } from "@lucide/astro";
import { SECTIONS, SITE } from "../data/site";
---

<nav class="jnav" id="journey-nav" aria-label="Journey sections">
  <div class="jnav__inner">
    <a class="jnav__brand" href="#top" aria-label={`${SITE.name}, back to top`}>
      <span class="jnav__mark" aria-hidden="true">AN</span>
      <span class="jnav__wordmark" aria-hidden="true">{SITE.name}</span>
    </a>

    <div class="jnav__timeline">
      <ol class="jnav__list" id="journey-list">
        {
          SECTIONS.map((section, index) => (
            <li class="jnav__item">
              <a class="jnav__link" href={`#${section.id}`} data-nav-link data-index={index}>
                <span class="jnav__num">{section.number}</span>
                <span class="jnav__label">{section.label}</span>
                <span class="jnav__short">{section.short}</span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="jnav__track" id="journey-track" aria-hidden="true">
        <svg class="jnav__wire" id="journey-wire" preserveAspectRatio="none" aria-hidden="true">
          <path class="jnav__wire-base" id="journey-wire-base" fill="none"></path>
          <path class="jnav__wire-progress" id="journey-wire-progress" fill="none"></path>
          {SECTIONS.map((section) => <circle class="jnav__peg" data-peg={section.id} r="2.5" />)}
        </svg>

        <span class="jnav__knob" id="journey-knob">
          <span class="jnav__knob-pin"></span>
          <span class="jnav__knob-stem"></span>
          <span class="jnav__knob-pendant">
            <MoveHorizontal class="jnav__knob-icon" />
          </span>
          <span class="jnav__knob-hint">Drag to scrub</span>
        </span>
      </div>
    </div>
  </div>
</nav>

<style>
  .jnav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-height-mobile);
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .jnav__inner {
    position: relative;
    height: 100%;
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-5);
  }

  /* ---- Brand ------------------------------------------------- */
  .jnav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .jnav__mark {
    display: grid;
    place-items: center;
    width: var(--brand-mark);
    height: var(--brand-mark);
    border-radius: var(--radius-sm);
    background-color: var(--color-accent);
    color: var(--color-invert-text);
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-eyebrow);
  }

  .jnav__wordmark {
    display: none;
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    white-space: nowrap;
  }

  /* ---- Mobile: horizontally scrollable pill bar -------------- */
  .jnav__list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    /* Let pills run to the screen edge rather than stopping short. */
    margin-inline: calc(-1 * var(--space-5));
    padding-inline: var(--space-5);
  }

  .jnav__list::-webkit-scrollbar {
    display: none;
  }

  .jnav__item {
    flex: none;
  }

  .jnav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-md);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    font-size: var(--text-nav);
    font-weight: var(--weight-heading);
    line-height: var(--leading-small);
    color: var(--color-text-muted);
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .jnav__link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .jnav__link[aria-current="true"] {
    color: var(--color-invert-text);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .jnav__num {
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
  }

  .jnav__link[aria-current="true"] .jnav__num {
    color: var(--color-accent-deep);
  }

  /* The full label is desktop-only; the pill shows the short form. */
  .jnav__label {
    display: none;
  }

  .jnav__track {
    display: none;
  }

  /* ---- Desktop: the timeline ---------------------------------- */
  @media (width >= 1024px) {
    .jnav {
      height: var(--nav-height);
    }

    /*
     * The timeline is deliberately not full-bleed. It shares the bar
     * with the brand and gives back a further slice on the right, so
     * the labels sit at a readable rhythm instead of being stretched
     * across the whole viewport.
     */
    .jnav__timeline {
      padding-right: var(--space-8);
    }

    .jnav__list {
      align-items: flex-end;
      gap: 0;
      height: auto;
      padding-block: var(--space-5) var(--space-3);
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
      justify-content: space-between;
    }

    .jnav__link {
      flex-direction: column;
      align-items: center;
      gap: var(--space-1);
      min-height: 0;
      padding-inline: var(--space-2);
      border: none;
      background: none;
      border-radius: 0;
    }

    .jnav__link:hover,
    .jnav__link[aria-current="true"] {
      background: none;
      color: var(--color-accent);
    }

    .jnav__num {
      font-size: var(--text-eyebrow);
      letter-spacing: var(--tracking-eyebrow);
    }

    .jnav__link[aria-current="true"] .jnav__num {
      color: var(--color-accent);
    }

    .jnav__label {
      display: block;
    }

    .jnav__short {
      display: none;
    }

    .jnav__track {
      display: block;
      position: relative;
      height: var(--track-height);
    }

    /*
     * The rule is drawn as an SVG path rather than a div so it can bend.
     * The handle pulls the wire down with it, easing back to straight at
     * either end, which makes the timeline read as something physically
     * connected to the page rather than a progress bar.
     */
    .jnav__wire {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .jnav__wire-base {
      stroke: var(--color-text-faint);
      stroke-width: var(--hairline);
      opacity: 0.5;
    }

    .jnav__wire-progress {
      stroke: var(--color-accent);
      stroke-width: 1.5;
      stroke-linecap: round;
    }

    .jnav__peg {
      fill: var(--color-border);
      transition: fill var(--duration-fast) var(--ease-out);
    }

    .jnav__peg[data-passed="true"] {
      fill: var(--color-accent);
    }

    .jnav__peg[data-active="true"] {
      fill: var(--color-accent);
    }

    /*
     * The scrub control hangs below the line as a pendant, so it reads
     * as a physical thing to grab rather than a dot to look at. It is
     * deliberately the largest element in the bar. The whole assembly
     * is a single positioned wrapper; only the pin and the disc take
     * pointer events, so the label and the empty space beside it never
     * intercept clicks meant for the page underneath.
     */
    /* `top` and `left` are set per frame in journey.ts so the handle
       stays on the sagging wire rather than on a straight line. */
    .jnav__knob {
      position: absolute;
      top: 0;
      left: 0;
      translate: -50% 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      pointer-events: none;
      touch-action: none;
    }

    .jnav__knob-pin {
      width: var(--knob-size);
      height: var(--knob-size);
      border-radius: var(--radius-pill);
      background-color: var(--color-accent);
      /* Sits centred on the 1px line. */
      margin-top: calc(-1 * var(--knob-size) / 2);
      display: grid;
      place-items: center;
      pointer-events: auto;
      cursor: grab;
    }

    .jnav__knob-pin::after {
      content: "";
      width: var(--knob-dot);
      height: var(--knob-dot);
      border-radius: var(--radius-pill);
      background-color: var(--color-gold);
    }

    .jnav__knob-stem {
      width: var(--hairline);
      height: var(--knob-stem);
      background-color: var(--color-accent);
      opacity: 0.4;
    }

    .jnav__knob-pendant {
      display: grid;
      place-items: center;
      width: var(--knob-pendant);
      height: var(--knob-pendant);
      border-radius: var(--radius-pill);
      background-color: var(--color-accent);
      color: var(--color-invert-text);
      box-shadow: var(--shadow-pill);
      pointer-events: auto;
      cursor: grab;
      transition:
        scale var(--duration-fast) var(--ease-out),
        background-color var(--duration-fast) var(--ease-out);
    }

    .jnav__knob-pendant:hover {
      scale: 1.08;
    }

    .jnav__knob-icon {
      width: var(--icon-md);
      height: var(--icon-md);
      stroke-width: 1.5;
    }

    /* Take pointer events for the whole assembly while a drag is live,
       so pointer capture keeps delivering moves to the wrapper. */
    .jnav__knob[data-dragging="true"] {
      pointer-events: auto;
    }

    .jnav__knob[data-dragging="true"] .jnav__knob-pendant {
      scale: 1.12;
      background-color: var(--color-invert-surface);
      cursor: grabbing;
    }

    .jnav__knob[data-dragging="true"] .jnav__knob-pin {
      cursor: grabbing;
    }

    .jnav__knob-hint {
      margin-top: var(--space-2);
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-pill);
      background-color: var(--color-invert-surface);
      color: var(--color-invert-text);
      font-size: var(--text-eyebrow);
      font-weight: var(--weight-heading);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      white-space: nowrap;
      transition: opacity var(--duration-base) var(--ease-out);
      pointer-events: none;
    }

    /*
     * The label is shown up front because a drag affordance nobody
     * notices is the same as not having one. Once the reader has
     * actually scrubbed or moved down the page they have learnt it, so
     * it steps back and only returns on hover.
     */
    .jnav__knob[data-taught="true"] .jnav__knob-hint {
      opacity: 0;
    }

    .jnav__knob[data-taught="true"]:hover .jnav__knob-hint,
    .jnav__knob[data-dragging="true"] .jnav__knob-hint {
      opacity: 1;
    }

    /* A slow nudge to catch the eye, only until the reader gets it. */
    @media not (prefers-reduced-motion: reduce) {
      .jnav__knob:not([data-taught="true"]) .jnav__knob-pendant {
        animation: knob-nudge 2.6s var(--ease-out) infinite;
      }
    }

    @keyframes knob-nudge {
      0%,
      70%,
      100% {
        translate: 0 0;
      }
      80% {
        translate: var(--space-2) 0;
      }
      90% {
        translate: calc(-1 * var(--space-2)) 0;
      }
    }
  }

  /* The wordmark only earns its space once the bar is comfortably wide. */
  @media (width >= 1280px) {
    .jnav__wordmark {
      display: block;
    }
  }

  /* No drag affordance where there is no pointer to drag with. */
  @media (pointer: coarse) {
    .jnav__knob {
      cursor: default;
    }

    .jnav__knob-hint {
      display: none;
    }
  }
</style>
