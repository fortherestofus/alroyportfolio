---
/**
 * Section 05: the products, one card each.
 *
 * Screenshots sit in a scroll-snapping rail rather than a carousel.
 * These are supporting evidence for the description, not the main
 * event, so a native scroll container gives keyboard, trackpad, touch
 * and screen-reader behaviour for free with no JS to get wrong.
 * The portfolio modal stays the one place with a real carousel.
 */
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import Placeholder from "./Placeholder.astro";
import { PRODUCTS, productImage, hasCaseStudyPage } from "../data/products";

/*
 * Phone screenshots are tall and only ever shown small, so they are
 * sized by height. Web captures are sized by width. Both well under
 * what the rail displays at 2x.
 */
const PHONE_HEIGHT = 560;
const SCREEN_WIDTH = 720;
const SHOT_QUALITY = 74;

/** Mirrors --shot-*-ratio, so a missing capture leaves the right hole. */
const SHAPE_RATIO = { phone: "9/19.5", panel: "3/4", screen: "16/10" } as const;

/** Product names carry punctuation ("tapa."), ids should not. */
const slug = (name: string) =>
  name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/-$/, "");
---

<div class="products">
  {
    PRODUCTS.map((product) => (
      <article class="product" data-reveal>
        <header class="product__head" data-reveal-item>
          <div class="product__naming">
            <h3 class="product__name">{product.name}</h3>
            <p class="product__tagline">{product.tagline}</p>
          </div>
          <ul class="product__meta">
            <li class="product__chip">{product.status}</li>
            <li class="product__chip">{product.platform}</li>
            <li class="product__chip">{product.category}</li>
          </ul>
        </header>

        <p class="product__description" data-reveal-item>
          {product.description}
        </p>

        <div class="product__stack" data-reveal-item>
          <h4 class="product__stack-label" id={`stack-${slug(product.name)}`}>
            Built with
          </h4>
          <ul class="product__stack-list" aria-labelledby={`stack-${slug(product.name)}`}>
            {product.stack.map((tech) => (
              <li class="product__tech">{tech}</li>
            ))}
          </ul>
        </div>

        {(hasCaseStudyPage(product.caseStudy) || product.link) && (
          <p class="product__link" data-reveal-item>
            {hasCaseStudyPage(product.caseStudy) && (
              <a href={`/case-studies/${product.caseStudy}/`}>
                Read the case study
                <ArrowUpRight class="product__link-icon" aria-hidden="true" />
              </a>
            )}
            {product.link && (
              <a href={product.link.url} target="_blank" rel="noopener noreferrer">
                {product.link.label}
                <ArrowUpRight class="product__link-icon" aria-hidden="true" />
              </a>
            )}
          </p>
        )}

        <ul
          class:list={["product__rail", `product__rail--${product.shape}`]}
          tabindex="0"
          aria-label={`${product.name} screenshots`}
          data-reveal-item
        >
          {product.shots.map((shot) => {
            const image = productImage(shot.image);
            return (
              <li class="product__shot">
                {image ? (
                  <Image
                    src={image}
                    alt={shot.alt}
                    {...(product.shape === "screen"
                      ? { width: SCREEN_WIDTH }
                      : { height: PHONE_HEIGHT })}
                    quality={SHOT_QUALITY}
                    densities={[1]}
                    loading="lazy"
                  />
                ) : (
                  <Placeholder
                    label={`products/${shot.image}`}
                    ratio={SHAPE_RATIO[product.shape]}
                  />
                )}
              </li>
            );
          })}
        </ul>
      </article>
    ))
  }
</div>

<style>
  .products {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .product {
    padding: var(--space-5);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .product__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .product__name {
    font-size: var(--text-h3);
  }

  .product__tagline {
    margin-top: var(--space-1);
    font-size: var(--text-small);
    color: var(--color-accent);
  }

  .product__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product__chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-sm);
    padding-inline: var(--space-3);
    background-color: var(--color-accent-soft);
    border-radius: var(--radius-pill);
    font-size: var(--text-chip);
    font-weight: var(--weight-heading);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .product__description {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  /* --- Stack ---------------------------------------------------
   * Deliberately quieter than the status chips above: those are the
   * headline facts, this is the receipt. Outlined rather than filled
   * so ten of them in a row do not out-shout the description.
   */
  .product__stack {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .product__stack-label {
    font-size: var(--text-eyebrow);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .product__stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product__tech {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-sm);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-chip);
    font-size: var(--text-chip);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .product__link {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-4);
  }

  .product__link a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-md);
    font-size: var(--text-small);
    font-weight: var(--weight-heading);
    color: var(--color-accent);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .product__link a:hover,
  .product__link a:focus-visible {
    border-bottom-color: var(--color-accent);
  }

  .product__link-icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
    stroke-width: 2;
  }

  /* --- Screenshot rail ---------------------------------------- */
  .product__rail {
    display: flex;
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0 0 var(--space-3);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .product__shot {
    flex: none;
    scroll-snap-align: start;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
  }

  /*
   * Every frame in a rail is identical and every capture fills it.
   * How it fills depends on what it is a picture of.
   */
  .product__rail :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /*
   * Phone captures read as devices: narrow, tall, rounded. They already
   * arrive at roughly the frame's ratio, so `cover` trims a few percent
   * and buys an edge-to-edge screen.
   */
  .product__rail--phone .product__shot {
    width: var(--shot-phone-width);
    aspect-ratio: var(--shot-phone-ratio);
    border-radius: var(--radius-card);
  }

  .product__rail--phone :global(img) {
    object-fit: cover;
    object-position: center top;
  }

  /* An extension popup: roughly 3:4, and shown at its own size. */
  .product__rail--panel .product__shot {
    width: var(--shot-panel-width);
    aspect-ratio: var(--shot-panel-ratio);
  }

  .product__rail--panel :global(img) {
    object-fit: cover;
    object-position: center top;
  }

  /*
   * Web captures arrive at whatever the window was, anywhere from 4:3
   * to 2:1. Letterboxing them inside a common frame keeps every pixel
   * but leaves bands of dead backing, which Alroy read — fairly — as
   * the image failing to fill its frame. So they fill it, anchored to
   * the top, where the header and the headline of a UI capture are.
   */
  .product__rail--screen .product__shot {
    width: var(--shot-screen-width);
    aspect-ratio: var(--shot-screen-ratio);
  }

  .product__rail--screen :global(img) {
    object-fit: cover;
    object-position: center top;
  }

  /* A missing capture leaves a hole the exact size of the real one. */
  .product__shot :global(.placeholder) {
    height: 100%;
  }

  @media (width >= 640px) {
    .product {
      padding: var(--space-6);
    }
  }
</style>
