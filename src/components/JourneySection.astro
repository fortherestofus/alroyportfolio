---
/**
 * A two-column journey section (PRD §5.2).
 *
 * Left column (5/12) holds the giant number, heading and blurb, and stays put while the right column (7/12) scrolls past it.
 *
 * The pin is CSS `position: sticky` rather than a ScrollTrigger pin.
 * Sticky needs no pin-spacer, so it cannot produce the jump, overlap
 * or flicker at section boundaries that §12b tests for, it survives
 * resize with no refresh, and it still works with JS off or reduced
 * motion. ScrollTrigger is still what drives the crossfade and reveals.
 *
 * Below 1024px the columns stack and the left column becomes a plain
 * section header, with no sticky behaviour.
 */
import SectionLottie from "./SectionLottie.astro";

interface Props {
  id: string;
  number: string;
  label: string;
  heading: string;
  blurb: string;
  /** Filename in public/lottie, for the sections that carry one. */
  lottie?: string;
}

// `label` stays in Props (the nav reads the same objects) but is not
// rendered here: it repeated the heading almost word for word.
const { id, number, heading, blurb, lottie } = Astro.props;
---

<section class="jsection" id={id} aria-labelledby={`${id}-heading`}>
  <div class="jsection__grid">
    <div class="jsection__aside" data-section-aside>
      <p class="jsection__number" aria-hidden="true">{number}</p>
      <h2 id={`${id}-heading`} class="jsection__heading">{heading}</h2>
      <p class="jsection__blurb">{blurb}</p>
      {lottie && <SectionLottie name={lottie} />}
    </div>

    <div class="jsection__content">
      <slot />
    </div>
  </div>

  {
    /*
     * A full-width band under the two columns, for the rare thing that
     * genuinely cannot live in a 7/12 column. The booking calendar is
     * the case that forced it: Cal renders its month view as three
     * columns above roughly 900px and collapses to a 2,000px stack
     * below, so in the right-hand column it was four times taller than
     * it needed to be.
     */
    Astro.slots.has("wide") && (
      <div class="jsection__wide">
        <slot name="wide" />
      </div>
    )
  }
</section>

<style>
  .jsection {
    /* Anchor jumps must clear the fixed nav. */
    scroll-margin-top: var(--nav-height-mobile);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .jsection__grid {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
    display: grid;
    /* Stacked, but still floored at 0 so a wide child cannot stretch
       the column and push the page sideways. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  .jsection__number {
    font-size: var(--text-number);
    font-weight: var(--weight-heading);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-accent);
    opacity: 0.9;
  }

  .jsection__heading {
    margin-top: var(--space-3);
  }

  .jsection__blurb {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .jsection__wide {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
    margin-top: var(--space-7);
  }

  @media (width >= 1024px) {
    .jsection {
      scroll-margin-top: var(--nav-height);
      padding-block: var(--space-10);
    }

    .jsection__grid {
      /*
       * minmax(0, …) rather than a bare fr: an fr track has an automatic
       * min-content floor, so one wide child (the logo marquee) would
       * otherwise force the whole column open and push the page sideways.
       */
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-7);
      align-items: start;
    }

    .jsection__aside {
      position: sticky;
      /* Clear the nav, then breathe. */
      top: calc(var(--nav-height) + var(--space-7));
      /* Required for sticky to engage inside a grid track. */
      align-self: start;
    }

    .jsection__blurb {
      max-width: var(--measure);
    }
  }

  /*
   * Short viewports: the giant number plus heading and blurb can exceed
   * the space under the nav, which would strand the bottom of the
   * sticky column off-screen. Shrink the number rather than let that
   * happen.
   */
  @media (width >= 1024px) and (height <= 760px) {
    .jsection__number {
      font-size: var(--text-h2);
    }
  }
</style>
